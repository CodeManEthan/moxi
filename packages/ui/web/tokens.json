{
  "$description": "The theme every page and component shares. Each token is the custom property --moxi-<name>; npm run build writes theme.css from this file. A colour has its light value in $value and its dark value in $extensions.moxi.dark. Adding a token is contract 1; removing or renaming one is contract 2.",
  "bg": {
    "$type": "color",
    "$value": "#ffffff",
    "$description": "the page's background",
    "$extensions": {
      "moxi": {
        "dark": "#14171c"
      }
    }
  },
  "bg-sunken": {
    "$type": "color",
    "$value": "#f6f7f9",
    "$description": "a recessed area: wells, code, inputs",
    "$extensions": {
      "moxi": {
        "dark": "#0f1216"
      }
    }
  },
  "bg-raised": {
    "$type": "color",
    "$value": "#ffffff",
    "$description": "a raised surface: cards, menus",
    "$extensions": {
      "moxi": {
        "dark": "#1a1e25"
      }
    }
  },
  "bg-hover": {
    "$type": "color",
    "$value": "#eef0f4",
    "$description": "a row or control under the pointer",
    "$extensions": {
      "moxi": {
        "dark": "#232833"
      }
    }
  },
  "border": {
    "$type": "color",
    "$value": "#d9dde3",
    "$description": "a quiet border",
    "$extensions": {
      "moxi": {
        "dark": "#2b313b"
      }
    }
  },
  "border-strong": {
    "$type": "color",
    "$value": "#b8c0cc",
    "$description": "a border that must be seen",
    "$extensions": {
      "moxi": {
        "dark": "#3c4450"
      }
    }
  },
  "text": {
    "$type": "color",
    "$value": "#14181f",
    "$description": "body text",
    "$extensions": {
      "moxi": {
        "dark": "#e6e9ee"
      }
    }
  },
  "text-dim": {
    "$type": "color",
    "$value": "#5b6472",
    "$description": "secondary text",
    "$extensions": {
      "moxi": {
        "dark": "#a0a9b6"
      }
    }
  },
  "text-faint": {
    "$type": "color",
    "$value": "#8b95a3",
    "$description": "hints and disabled text",
    "$extensions": {
      "moxi": {
        "dark": "#6d7684"
      }
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#2f6fd0",
    "$description": "links, focus and the main action",
    "$extensions": {
      "moxi": {
        "dark": "#6ea8ff"
      }
    }
  },
  "accent-soft": {
    "$type": "color",
    "$value": "#dbe7fa",
    "$description": "the accent's background",
    "$extensions": {
      "moxi": {
        "dark": "#1e2b40"
      }
    }
  },
  "error": {
    "$type": "color",
    "$value": "#c0392b",
    "$description": "an error's text and marks",
    "$extensions": {
      "moxi": {
        "dark": "#ff8a7a"
      }
    }
  },
  "error-soft": {
    "$type": "color",
    "$value": "#fbe4e1",
    "$description": "an error's background",
    "$extensions": {
      "moxi": {
        "dark": "#3a1f1c"
      }
    }
  },
  "warn": {
    "$type": "color",
    "$value": "#a86b00",
    "$description": "a warning's text and marks",
    "$extensions": {
      "moxi": {
        "dark": "#e0b45f"
      }
    }
  },
  "warn-soft": {
    "$type": "color",
    "$value": "#fdf0d8",
    "$description": "a warning's background",
    "$extensions": {
      "moxi": {
        "dark": "#3a2f18"
      }
    }
  },
  "ok": {
    "$type": "color",
    "$value": "#1f7a4d",
    "$description": "a good state's text and marks",
    "$extensions": {
      "moxi": {
        "dark": "#5fd39b"
      }
    }
  },
  "live": {
    "$type": "color",
    "$value": "#1f9d55",
    "$description": "something running now",
    "$extensions": {
      "moxi": {
        "dark": "#4fd18b"
      }
    }
  },
  "add-soft": {
    "$type": "color",
    "$value": "#e2f5e8",
    "$description": "an added line's background",
    "$extensions": {
      "moxi": {
        "dark": "#16301f"
      }
    }
  },
  "del-soft": {
    "$type": "color",
    "$value": "#fbe6e6",
    "$description": "a removed line's background",
    "$extensions": {
      "moxi": {
        "dark": "#35191a"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": "6px",
    "$description": "the corner radius of controls"
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": "10px",
    "$description": "the corner radius of cards and panels"
  },
  "gap": {
    "$type": "dimension",
    "$value": "12px",
    "$description": "the space between blocks"
  },
  "font-sans": {
    "$type": "fontFamily",
    "$value": [
      "ui-sans-serif",
      "system-ui",
      "-apple-system",
      "Segoe UI",
      "Roboto",
      "Helvetica",
      "Arial",
      "sans-serif"
    ],
    "$description": "text"
  },
  "font-mono": {
    "$type": "fontFamily",
    "$value": [
      "ui-monospace",
      "SFMono-Regular",
      "SF Mono",
      "Menlo",
      "Consolas",
      "Liberation Mono",
      "monospace"
    ],
    "$description": "code, ids and paths"
  },
  "font-size": {
    "$type": "dimension",
    "$value": "14px",
    "$description": "body text's size"
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": "12px",
    "$description": "small text's size"
  }
}
