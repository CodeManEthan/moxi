{
  "$description": "The theme every page and component shares. Each token is the custom property --moxi-<name>; npm run build writes theme.css from this file. $themes names the themes, each a light set and a dark set, the first the default; $sets names the colour sets, each with the one mode it shows in. A colour token has one value per set in $extensions.moxi.sets, and no other token names a set. Adding a token is contract 1; removing or renaming one is contract 2.",
  "$themes": {
    "plain": {
      "light": "plain-day",
      "dark": "plain-night"
    },
    "midnight-neon": {
      "light": "calm-workbench",
      "dark": "midnight-neon"
    }
  },
  "$sets": {
    "plain-day": {
      "mode": "light",
      "$description": "Near-white paper and near-black type; one blue accent, and states told in words."
    },
    "plain-night": {
      "mode": "dark",
      "$description": "Near-black and soft white type; one blue accent, and states told in words."
    },
    "calm-workbench": {
      "mode": "light",
      "$description": "Warm paper grey; type and spacing carry the hierarchy."
    },
    "midnight-neon": {
      "mode": "dark",
      "$description": "A near-black violet night; neon marks meaning only."
    }
  },
  "bg": {
    "$type": "color",
    "$description": "the page's background",
    "$extensions": {
      "moxi": {
        "sets": {
          "plain-day": "#fafaf8",
          "plain-night": "#151515",
          "calm-workbench": "#f6f4f1",
          "midnight-neon": "#0a0918"
        }
      }
    }
  },
  "bg-sunken": {
    "$type": "color",
